{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Clean Studio",
  "version": "1.1.0",
  "identifier": "com.cleanstudio.desktop",
  "build": {
    "beforeDevCommand": "node scripts/build-studio-ui.mjs",
    "beforeBuildCommand": "node scripts/build-studio-ui.mjs",
    "frontendDist": "../studio-ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": {
        "default-src": "'self' ipc: http://ipc.localhost",
        "connect-src": "'self' ipc: http://ipc.localhost http://localhost:* http://127.0.0.1:* ws://localhost:* ws://127.0.0.1:*",
        "img-src": "'self' asset: data: blob: http://localhost:* http://127.0.0.1:* https://i.ytimg.com https://img.youtube.com",
        "media-src": "'self' blob: data: http://localhost:* http://127.0.0.1:*",
        "style-src": "'self' 'unsafe-inline'",
        "font-src": "'self' data:",
        "script-src": "'self' 'unsafe-eval' 'wasm-unsafe-eval' blob:",
        "worker-src": "'self' blob:",
        "frame-src": "https://www.youtube.com https://www.youtube-nocookie.com"
      },
      "dangerousDisableAssetCspModification": ["style-src"]
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": {
      "../engines-bundle/": "engines/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
